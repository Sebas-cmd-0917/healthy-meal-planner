{
  "name": "healthy-meal-planner-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
