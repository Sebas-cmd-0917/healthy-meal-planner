PORT=3000
NODE_ENV=development
# Origen del front (Vite local o dominio de Vercel). Varios separados por coma.
CORS_ORIGIN=http://localhost:5173

# memory = sin base de datos (desarrollo) | supabase = Supabase real
PERSISTENCE=memory
SUPABASE_URL=
# Secret key (sb_secret_...): SOLO en el backend, nunca en el front
SUPABASE_SECRET_KEY=

# n8n local (o la URL del túnel si el back corre fuera de tu máquina)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=
